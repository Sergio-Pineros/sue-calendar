# Public site origin (Open Graph, live demo). Leave blank in local dev.
# NEXT_PUBLIC_SITE_URL=https://YOUR-VERCEL-URL

# Google Calendar (client-side OAuth, read + write)
# Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs: http://localhost:3000
# Enable the Google Calendar API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apple / iCloud Calendar — users enter an Apple ID + app-specific password
# in Settings. The Next.js /api/caldav route proxies CalDAV and never stores
# credentials. Native / static-export builds have no /api route; point this
# at the deployed Vercel origin instead:
# NEXT_PUBLIC_CALDAV_URL=https://YOUR-VERCEL-URL/api/caldav
NEXT_PUBLIC_CALDAV_URL=
